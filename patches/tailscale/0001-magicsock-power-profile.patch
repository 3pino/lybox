diff -ruN a/wgengine/magicsock/lybox_power.go b/wgengine/magicsock/lybox_power.go
--- a/wgengine/magicsock/lybox_power.go	1970-01-01 09:00:00.000000000 +0900
+++ b/wgengine/magicsock/lybox_power.go	2026-11-12 17:52:30.541979225 +0900
@@ -0,0 +1,88 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"sync/atomic"
+	"time"
+
+	"tailscale.com/net/netcheck"
+)
+
+// PowerProfile lets an embedding app trade path-maintenance chatter for
+// battery life at runtime. The zero value keeps upstream behaviour.
+type PowerProfile struct {
+	// HeartbeatInterval is how often the best direct path is pinged while a
+	// session is active. Zero means the upstream default (3s).
+	HeartbeatInterval time.Duration
+
+	// UpgradeDirectInterval is how often a better direct path is searched for
+	// while a working one exists. Zero means the upstream default (1m).
+	UpgradeDirectInterval time.Duration
+
+	// PeriodicSTUNInterval is the delay between background STUN/netcheck
+	// rounds while a session is active. Zero means the upstream default
+	// (20-26s); a negative value disables periodic STUN entirely.
+	PeriodicSTUNInterval time.Duration
+
+	// NetcheckMinInterval, when positive, makes updateNetInfo reuse the last
+	// netcheck report instead of probing again while that report is younger
+	// than this. Without UDP every netcheck degrades to HTTPS latency probes
+	// against every DERP region (~1MB each), so DERP-only mode wants this large.
+	NetcheckMinInterval time.Duration
+}
+
+var powerProfile atomic.Pointer[PowerProfile]
+
+// SetPowerProfile installs p for all current and future connections.
+func SetPowerProfile(p PowerProfile) { powerProfile.Store(&p) }
+
+func heartbeatIntervalNow() time.Duration {
+	if p := powerProfile.Load(); p != nil && p.HeartbeatInterval > 0 {
+		return p.HeartbeatInterval
+	}
+	return heartbeatInterval
+}
+
+// trustUDPAddrDurationNow keeps the upstream 6.5s/3s ratio (3.5s of slack
+// after a missed heartbeat) when the heartbeat interval is stretched.
+func trustUDPAddrDurationNow() time.Duration {
+	if p := powerProfile.Load(); p != nil && p.HeartbeatInterval > 0 {
+		return p.HeartbeatInterval + trustUDPAddrDuration - heartbeatInterval
+	}
+	return trustUDPAddrDuration
+}
+
+func upgradeUDPDirectIntervalNow() time.Duration {
+	if p := powerProfile.Load(); p != nil && p.UpgradeDirectInterval > 0 {
+		return p.UpgradeDirectInterval
+	}
+	return upgradeUDPDirectInterval
+}
+
+// periodicSTUNDelay returns the delay before the next periodic STUN round and
+// whether periodic STUN is enabled at all.
+func periodicSTUNDelay(upstream time.Duration) (time.Duration, bool) {
+	if p := powerProfile.Load(); p != nil {
+		if p.PeriodicSTUNInterval < 0 {
+			return 0, false
+		}
+		if p.PeriodicSTUNInterval > 0 {
+			return p.PeriodicSTUNInterval, true
+		}
+	}
+	return upstream, true
+}
+
+// cachedNetcheck returns the last report if it is fresh enough to skip a probe.
+func cachedNetcheck(last *netcheck.Report) (*netcheck.Report, bool) {
+	p := powerProfile.Load()
+	if p == nil || p.NetcheckMinInterval <= 0 || last == nil || last.Now.IsZero() {
+		return nil, false
+	}
+	if time.Since(last.Now) < p.NetcheckMinInterval {
+		return last, true
+	}
+	return nil, false
+}
